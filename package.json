{
  "name": "didit-events-monorepo",
  "version": "0.1.0",
  "description": "Event management with liveness verification and face check-in, built on Didit.",
  "license": "MIT",
  "homepage": "https://github.com/didit-protocol/didit-events#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/didit-protocol/didit-events.git"
  },
  "bugs": {
    "url": "https://github.com/didit-protocol/didit-events/issues"
  },
  "engines": {
    "node": ">=22.7"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @didit-events/core db:generate",
    "db:migrate": "pnpm --filter @didit-events/core db:migrate",
    "size": "node scripts/size-report.mjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "db:seed": "pnpm seed",
    "seed": "pnpm --filter @didit-events/events exec node --experimental-transform-types scripts/seed-events.ts",
    "smoke:local": "node --experimental-transform-types scripts/smoke-local.mjs",
    "e2e:journey": "node --experimental-transform-types scripts/e2e/journey.mjs",
    "email:audit": "node --experimental-transform-types --no-warnings packages/core/scripts/email-audit.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
