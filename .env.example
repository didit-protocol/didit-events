# Didit Events configuration.
#
# Development:     cp .env.example apps/events/.env.local
# docker compose:  cp .env.example .env
#
# Fill in the uncommented variables: they are the ones the app needs to start. Two exceptions: DATABASE_URL may
# stay empty, which selects PGlite, and the three spend ceilings already hold small starting amounts.
# Everything else is optional and commented out; remove the leading "# " from a NAME= line to set it. Leave
# what you do not use commented out: some variables treat an empty value as an error instead of falling back to
# the default.
# The values here are placeholders. Never commit a filled-in copy: .env files are git-ignored.
#
# "Build time" means the value is read by `pnpm build` (or passed as a Docker build argument), not when the
# server starts. "Build time and runtime" means both: give the build and the server the same value.
# The same list, as one short table, is in the README under Configuration.
#
# Signing in: with the API key of a sandbox application, email codes are never confirmed. Development uses
# DEV_AUTH=1 (localhost only). A production build or the Docker image needs DIDIT_OTP_API_KEY from a production
# application, or an OIDC client (DIDIT_OIDC_CLIENT_ID and DIDIT_OIDC_CLIENT_SECRET).


# ============================================================================================================
# CORE
# The app does not start without the two required values.
# ============================================================================================================

# APP_URL  [required]
# Public origin of the app. Used in links, emails, cookies and same-origin checks.
# Default: none. Example: https://events.example.com
# How to get it: Your own domain, without a trailing path. http://localhost:3000 for local development.
APP_URL=http://localhost:3000

# SESSION_SECRET  [required]
# Signs session and CSRF cookies. At least 32 characters. Use a different one per environment.
# Default: none. Example: 44 random base64 characters
# How to get it: Generate it: openssl rand -base64 32
SESSION_SECRET=

# TRUSTED_PROXY_HOPS  [optional]
# Number of reverse proxies in front of the app. Decides which X-Forwarded-For entry is the client address
# (rate limits).
# Default: 1. Example: 2
# How to get it: Count the proxies of your hosting setup (load balancer, CDN). 0 when the app is reached
# directly.
# TRUSTED_PROXY_HOPS=

# PORT  [optional]
# Port of the standalone server (the Docker image). pnpm dev always uses 3000; the quick start shows how to
# pick another one.
# Default: 3000. Example: 8080
# How to get it: Your choice.
# PORT=

# WORKERS  [optional]
# 0 turns off every in-process worker (webhook inbox, email outbox, jobs).
# Default: on. Example: 0
# How to get it: Leave unset. There is no command that runs the workers on their own yet, so with 0 nothing
# processes webhooks, emails or jobs. The tests use it.
# WORKERS=

# VERIFICATION_WORKERS  [optional]
# 0 turns off only the verification workers. WORKERS=0 takes precedence.
# Default: on. Example: 0
# How to get it: Leave unset.
# VERIFICATION_WORKERS=

# NEXT_MANUAL_SIG_HANDLE  [optional]
# 1 lets the workers drain on SIGTERM or SIGINT before the process exits.
# Default: none. Example: 1
# How to get it: Already set by the package scripts and the Docker image. Set it yourself only when you start
# server.js by hand.
# NEXT_MANUAL_SIG_HANDLE=

# GIT_SHA  [optional, build time]
# Build id. The door kiosk compares it with the server's and offers a reload after a deploy. Also the default
# Sentry release.
# Default: none. Example: 3f2c1ab
# How to get it: Your CI: git rev-parse --short HEAD, passed as a build argument.
# GIT_SHA=

# NEXT_PUBLIC_BUILD_ID  [optional, build time]
# Overrides the build id when you do not want to use the commit.
# Default: GIT_SHA, else a timestamp. Example: 2026-10-02.1
# How to get it: Your choice.
# NEXT_PUBLIC_BUILD_ID=


# ============================================================================================================
# YOUR ORGANIZATION
# Who may be global staff, who the first owner is and which address guests write to. The first two have no
# default: pnpm db:migrate, pnpm seed, the Docker image and the server stop with a message until both are set.
# ============================================================================================================

# STAFF_EMAIL_DOMAIN  [required, build time and runtime]
# Email domains whose addresses may be global staff (owner, admin, staff), comma-separated. Membership still
# needs an invite. Event teams are not limited by it.
# Default: none. Example: yourcompany.com
# How to get it: Your company's email domain. Set it before pnpm build and when the server runs: the team page
# gets it at build time. The Docker build refuses to run without it.
STAFF_EMAIL_DOMAIN=

# SEED_OWNER_EMAIL  [required]
# The first owner, created by the first migration. Must be an address in STAFF_EMAIL_DOMAIN.
# Default: none. Example: you@yourcompany.com
# How to get it: Your own address. Set it before the first pnpm db:migrate or the first start of the Docker
# image; later changes do not rename the owner.
SEED_OWNER_EMAIL=

# CONTACT_EMAIL  [optional (recommended), build time and runtime]
# The address people are told to write to: "Questions?" links, error screens, the Reply-To of every email and
# the calendar organizer.
# Default: events@example.com. Example: events@example.com
# How to get it: A mailbox you read. Keep it commented out until you have one: an empty value is rejected. Set
# it before pnpm build and when the server runs: pages get it at build time, emails when they are sent.
# CONTACT_EMAIL=


# ============================================================================================================
# DATABASE
# Empty means PGlite, an embedded Postgres stored on disk, for one process at a time. Use a real Postgres in
# production; the README lists what needs it (Quick start, Which database).
# ============================================================================================================

# DATABASE_URL  [optional (production)]
# Postgres connection string. sslmode=require in the URL turns TLS on.
# Default: PGlite. Example: postgres://user:password@host:5432/didit_events?sslmode=require
# How to get it: Your Postgres provider, or locally: docker run -p 127.0.0.1:5432:5432 -e POSTGRES_PASSWORD=pg
# postgres:17 gives postgres://postgres:pg@127.0.0.1:5432/postgres, reachable from your machine only. docker
# compose sets it for you.
DATABASE_URL=

# PGLITE_DIR  [optional]
# Folder where PGlite keeps its files when DATABASE_URL is empty.
# Default: apps/events/.data/pglite. Example: /var/lib/didit-events/pglite
# How to get it: Any writable path.
# PGLITE_DIR=


# ============================================================================================================
# DIDIT
# Everything comes from one application in the Didit Business Console (https://business.didit.me). A sandbox
# application is enough for development. The three spend ceilings are set to small amounts here: raise them
# when you know what your events need.
# ============================================================================================================

# DIDIT_API_KEY  [required]
# Server-side key for the Didit API: sessions, decisions, face search, sign-in codes.
# Default: none. Example: <api key of your Didit application>
# How to get it: Didit Business Console → your application → API keys: https://business.didit.me
DIDIT_API_KEY=

# DIDIT_FACE_WORKFLOW_ID  [required]
# The liveness-only workflow every account takes once. It enrolls the face used at the door. On the first
# selfie check the app reads this workflow from Didit, checks that it is liveness only and stores its maximum
# price. There is no built-in workflow: pnpm db:migrate, pnpm seed, the Docker image and the server stop with
# a message until it is set.
# Default: none. Example: 00000000-0000-4000-8000-000000000000
# How to get it: Didit Business Console → Workflows → create a workflow with one feature, Liveness (passive) →
# publish → copy the workflow id (a UUID): https://business.didit.me
DIDIT_FACE_WORKFLOW_ID=

# DIDIT_RENEWAL_WORKFLOW_ID  [required]
# The workflow used when a guest renews an expired face check. It is also the one the provisioning script
# verifies. Set it to the same id as DIDIT_FACE_WORKFLOW_ID. Left out, the app still starts and new checks use
# DIDIT_FACE_WORKFLOW_ID, but renewals fail, so treat it as required. Set but empty, it is rejected as a
# configuration error.
# Default: none. Example: 00000000-0000-4000-8000-000000000000
# How to get it: Use the same value as DIDIT_FACE_WORKFLOW_ID.
DIDIT_RENEWAL_WORKFLOW_ID=

# DIDIT_WORKFLOW_ID  [required]
# Workflow id that sessions created by older versions refer to. The server refuses to start without it.
# Default: none. Example: 00000000-0000-4000-8000-000000000000
# How to get it: Use the same value as DIDIT_FACE_WORKFLOW_ID.
DIDIT_WORKFLOW_ID=

# DIDIT_WEBHOOK_SECRET  [optional (for webhooks)]
# Verifies the HMAC signature of Didit webhooks at /api/webhooks/didit. Without it the route answers 503 and
# results arrive by polling: within seconds while the guest keeps the page open, otherwise through the
# reconciler, which asks again every five minutes during the first hour of a check and every hour after that.
# Default: none. Example: <secret of the webhook destination>
# How to get it: Run node apps/events/scripts/webhook.mjs register https://<your-host>/api/webhooks/didit (it
# writes the secret to apps/events/.env.local), or Didit Business Console → Webhooks → create a destination
# with that URL → copy the secret: https://business.didit.me
# DIDIT_WEBHOOK_SECRET=

# DIDIT_ENV  [optional]
# Environment label: development, staging or production. Names the webhook destination (didit-events-<label>)
# and is the default Sentry environment.
# Default: guessed from the webhook URL. Example: production
# How to get it: Your choice.
# DIDIT_ENV=

# DIDIT_SPEND_CAP_USD  [optional (recommended)]
# Total ceiling for Didit spend, in USD. 0 blocks every billable call. When it is reached, calls are refused,
# not queued.
# Default: 1000. Example: 100
# How to get it: Your budget. Start small, as here, and raise it for a real event: one selfie check reserves
# the maximum price of your liveness workflow. Prices are in the Didit Business Console and on
# https://didit.me.
DIDIT_SPEND_CAP_USD=100

# DIDIT_APP_DAILY_CAP_USD  [optional (recommended)]
# Daily ceiling for the whole app, in USD.
# Default: 300. Example: 25
# How to get it: Your budget. Start small and raise it for a real event.
DIDIT_APP_DAILY_CAP_USD=25

# DIDIT_EVENT_DAILY_CAP_USD  [optional (recommended)]
# Daily ceiling for one event, in USD.
# Default: 150. Example: 10
# How to get it: Your budget. Start small and raise it for a real event.
DIDIT_EVENT_DAILY_CAP_USD=10

# DIDIT_AGE_WORKFLOW_ID  [optional]
# Age-estimation workflow from an older version, kept so its existing sessions still resolve. New installs do
# not need it.
# Default: none. Example: 00000000-0000-4000-8000-000000000000
# How to get it: Leave unset.
# DIDIT_AGE_WORKFLOW_ID=

# DIDIT_AGE_WORKFLOW_MAX_PRICE_USD  [optional]
# Maximum price of one session of DIDIT_AGE_WORKFLOW_ID, reserved in the spend ledger.
# Default: none. Example: 0.35
# How to get it: Leave unset.
# DIDIT_AGE_WORKFLOW_MAX_PRICE_USD=


# ============================================================================================================
# EMAIL
# Sign-in codes are sent by Didit. Everything else (confirmations, reminders, invites) goes through Resend.
# ============================================================================================================

# RESEND_API_KEY  [optional (for email)]
# Sends email. Without it messages stay pending in the outbox and nothing is sent; the email preview in the
# event editor still works. Setting it makes EMAIL_FROM and EMAIL_FOOTER required.
# Default: none. Example: <resend api key>
# How to get it: Resend dashboard → API Keys → Create API key (sending access): https://resend.com/api-keys
# RESEND_API_KEY=

# EMAIL_FROM  [required with RESEND_API_KEY]
# Sender address of every email. Required as soon as RESEND_API_KEY is set: migrations and the server stop
# with a message without it. A display name is used too: Events <events@example.com> sends as "Events". A bare
# address sends as "Didit Events".
# Default: none. Example: Events <events@example.com>
# How to get it: Resend dashboard → Domains → add and verify your domain, then use an address on it:
# https://resend.com/domains. Keep it commented out when unused: an empty value is rejected.
# EMAIL_FROM=

# EMAIL_FOOTER  [required with RESEND_API_KEY]
# The line under every email: who sends it and the postal address (one line, up to 300 characters). Required
# as soon as RESEND_API_KEY is set: migrations and the server stop with a message without it, so no email
# leaves with another organization's name. Without a key, the email preview shows Didit's line as a
# placeholder.
# Default: none. Example: Example Co · 1 Example Street, Lisbon
# How to get it: Your organization's legal name and postal address. Keep it commented out when unused: an
# empty value is rejected.
# EMAIL_FOOTER=

# RESEND_WEBHOOK_SECRET  [optional]
# Verifies Resend delivery events (delivered, bounced) at /api/webhooks/resend. Without it the route answers
# 404.
# Default: none. Example: <signing secret of the webhook>
# How to get it: Resend dashboard → Webhooks → add https://<your-host>/api/webhooks/resend → copy the signing
# secret: https://resend.com/webhooks
# RESEND_WEBHOOK_SECRET=

# EMAIL_ASSETS_URL  [optional]
# Public https origin that serves /email and /email-icons (images inside emails). A public https APP_URL
# serves them itself. On localhost the emails cannot load images from your machine, so their logo and icons
# point at Didit's deployment unless you set this: a mail client that opens such an email makes a request to
# events.didit.me.
# Default: APP_URL when it is public https, else https://events.didit.me. Example: https://your-domain.example
# How to get it: Any public https deployment of this app, for example your own production instance. Keep it
# commented out when unused: an empty value is rejected.
# EMAIL_ASSETS_URL=


# ============================================================================================================
# SIGN-IN
# Email-code sign-in needs only DIDIT_API_KEY of a production application. These add Google and cover sandbox
# applications. Google sign-in needs both client values and there is no built-in client: without them
# "Continue with Google" returns to the sign-in screen with a notice. See Didit setup in the README.
# ============================================================================================================

# DIDIT_OIDC_CLIENT_SECRET  [optional (for Google sign-in)]
# Secret of the Didit OIDC client behind "Continue with Google". Without it Google sign-in is unavailable and
# email codes still work.
# Default: none. Example: <client secret>
# How to get it: Issued by Didit together with the client id, for the redirect URI
# <APP_URL>/api/auth/oidc/callback. See Didit setup, step 5, in the README.
# DIDIT_OIDC_CLIENT_SECRET=

# DIDIT_OIDC_CLIENT_ID  [optional (for Google sign-in)]
# Id of the Didit OIDC client behind "Continue with Google". There is no built-in client: while it is unset,
# the app starts no Google sign-in.
# Default: none. Example: <client id>
# How to get it: Same as DIDIT_OIDC_CLIENT_SECRET. Keep it commented out when unused.
# DIDIT_OIDC_CLIENT_ID=

# DIDIT_OTP_API_KEY  [optional]
# Key of a second application that sends and checks the sign-in codes. Needed for email-code sign-in when
# DIDIT_API_KEY belongs to a sandbox application: the sandbox never confirms a code.
# Default: DIDIT_API_KEY. Example: <api key of a second Didit application>
# How to get it: Didit Business Console → a production application → API keys: https://business.didit.me
# DIDIT_OTP_API_KEY=

# DIDIT_OIDC_ISSUER  [optional]
# OIDC issuer the id token must name.
# Default: https://auth.didit.me/. Example: https://auth.didit.me/
# How to get it: Leave unset. Didit's public endpoints are built in.
# DIDIT_OIDC_ISSUER=

# DIDIT_OIDC_AUTHORIZE_URL  [optional]
# OIDC authorization endpoint.
# Default: https://apx.didit.me/auth/oidc/authorize. Example: https://apx.didit.me/auth/oidc/authorize
# How to get it: Leave unset.
# DIDIT_OIDC_AUTHORIZE_URL=

# DIDIT_OIDC_TOKEN_URL  [optional]
# OIDC token endpoint.
# Default: https://apx.didit.me/auth/oidc/token. Example: https://apx.didit.me/auth/oidc/token
# How to get it: Leave unset.
# DIDIT_OIDC_TOKEN_URL=

# DIDIT_OIDC_JWKS_URL  [optional]
# Keys that verify the id token.
# Default: https://apx.didit.me/auth/config/jwks. Example: https://apx.didit.me/auth/config/jwks
# How to get it: Leave unset.
# DIDIT_OIDC_JWKS_URL=


# ============================================================================================================
# OPTIONAL INTEGRATIONS
# Each feature is off when its key is empty.
# ============================================================================================================

# GOOGLE_MAPS_API_KEY  [optional]
# Location search in the event form (Places API, called from the server only). Without it hosts type the
# address by hand.
# Default: none. Example: <google maps api key>
# How to get it: Google Cloud console → APIs & Services → enable "Places API (New)" → Credentials → Create API
# key, restricted to that API: https://console.cloud.google.com/apis/credentials
# GOOGLE_MAPS_API_KEY=

# FIRECRAWL_API_KEY  [optional]
# Suggests the guest's LinkedIn and X profiles on the profile step (a web search by name and company).
# Default: none. Example: <firecrawl api key>
# How to get it: Firecrawl dashboard → API Keys: https://www.firecrawl.dev/app/api-keys
# FIRECRAWL_API_KEY=


# ============================================================================================================
# MONITORING
# Sentry, off by default. With no DSN the SDK is never started and nothing is sent.
# ============================================================================================================

# SENTRY_DSN  [optional]
# Error reporting for the server.
# Default: none. Example: https://<public-key>@<org>.ingest.sentry.io/<project-id>
# How to get it: Sentry → your project → Settings → Client Keys (DSN): https://sentry.io
# SENTRY_DSN=

# NEXT_PUBLIC_SENTRY_DSN  [optional, build time]
# Error reporting for the browser. Usually the same DSN.
# Default: none. Example: https://<public-key>@<org>.ingest.sentry.io/<project-id>
# How to get it: Same place as SENTRY_DSN. Pass it as a build argument.
# NEXT_PUBLIC_SENTRY_DSN=

# SENTRY_ENVIRONMENT  [optional]
# Environment name on Sentry events.
# Default: DIDIT_ENV, else development. Example: production
# How to get it: Your choice.
# SENTRY_ENVIRONMENT=

# NEXT_PUBLIC_ENVIRONMENT  [optional, build time]
# Environment name for browser events when SENTRY_ENVIRONMENT is not set at build time.
# Default: production in the Docker image. Example: staging
# How to get it: Your choice, as a build argument.
# NEXT_PUBLIC_ENVIRONMENT=

# SENTRY_RELEASE  [optional]
# Release name on Sentry events and source maps.
# Default: the build id. Example: didit-events@0.1.0
# How to get it: Your choice.
# SENTRY_RELEASE=

# SENTRY_TRACES_SAMPLE_RATE  [optional]
# Share of requests traced, from 0 to 1. 0 sends errors only.
# Default: 0. Example: 0.1
# How to get it: Your choice.
# SENTRY_TRACES_SAMPLE_RATE=

# SENTRY_AUTH_TOKEN  [optional, build time]
# Uploads source maps during pnpm build. Without it the build is the plain Next.js build.
# Default: none. Example: <sentry auth token>
# How to get it: Sentry → Settings → Auth Tokens → create an organization token:
# https://sentry.io/settings/auth-tokens/
# SENTRY_AUTH_TOKEN=

# SENTRY_ORG  [required with the token, build time]
# Sentry organization slug for the source map upload.
# Default: none. Example: acme
# How to get it: Sentry → Settings → Organization → slug.
# SENTRY_ORG=

# SENTRY_PROJECT  [required with the token, build time]
# Sentry project slug for the source map upload.
# Default: none. Example: didit-events
# How to get it: Sentry → your project → Settings → name.
# SENTRY_PROJECT=


# ============================================================================================================
# DEVELOPMENT ONLY
# For local work and tests. Never set these on a public deployment.
# ============================================================================================================

# DEV_AUTH  [optional]
# 1 enables /api/auth/dev, a sign-in without codes that marks the address as verified (on PGlite and on
# Postgres). It works only when APP_URL is localhost and is ignored when NODE_ENV=production.
# Default: off. Example: 1
# How to get it: Set it to 1 in apps/events/.env.local.
# DEV_AUTH=

# TEST_DATABASE_URL  [optional (CI)]
# A disposable Postgres where tests may create and drop databases. Adds the locking and migration suites to
# pnpm test (they are skipped without it, and mandatory when CI is set); used by pnpm smoke:local and pnpm
# e2e:journey.
# Default: none. Example: postgres://postgres:pg@127.0.0.1:5432/postgres
# How to get it: docker run -p 127.0.0.1:5432:5432 -e POSTGRES_PASSWORD=pg postgres:17, then wait until it
# accepts connections. Never point it at a database you care about.
# TEST_DATABASE_URL=

# DIDIT_SANDBOX_API_KEY  [optional]
# Read only by pnpm e2e:journey --provider sandbox, the one opt-in run that makes real calls to a sandbox
# application. Nothing else in the tests reads a real key.
# Default: none. Example: <api key of a sandbox application>
# How to get it: Didit Business Console → a sandbox application → API keys: https://business.didit.me
# DIDIT_SANDBOX_API_KEY=

# DIDIT_API_URL  [optional]
# Points the Didit client at a fake server. Only loopback http is accepted, and never in production.
# Default: https://verification.didit.me/v3/. Example: http://127.0.0.1:4010/
# How to get it: Set by the smoke and journey scripts. Leave unset.
# DIDIT_API_URL=

# RESEND_API_URL  [optional]
# Points email delivery at a fake server.
# Default: https://api.resend.com. Example: http://127.0.0.1:4011
# How to get it: Set by the smoke and journey scripts. Leave unset.
# RESEND_API_URL=

# SEED_ALLOW  [optional]
# 1 allows pnpm seed when NODE_ENV=production.
# Default: off. Example: 1
# How to get it: Set it for one command, not in a file.
# SEED_ALLOW=

# FRAMES  [optional]
# 1 serves the component gallery at /_frames in a production build. Always on in development.
# Default: off in production. Example: 1
# How to get it: Your choice.
# FRAMES=

# EMAIL_AUDIT_OFFLINE  [optional]
# 1 makes pnpm email:audit skip the network check of image URLs.
# Default: off. Example: 1
# How to get it: Set it for one command.
# EMAIL_AUDIT_OFFLINE=

# NEXT_DIST_DIR  [optional]
# Build folder of Next.js. The journey script uses its own so it does not clash with pnpm dev.
# Default: .next. Example: .next-e2e
# How to get it: Leave unset.
# NEXT_DIST_DIR=

# OG_OUT  [optional]
# File prefix where the Open Graph image tests save their PNGs so you can look at them.
# Default: none. Example: /tmp/og
# How to get it: Set it for one pnpm test run.
# OG_OUT=


# ============================================================================================================
# SET FOR YOU
# The code also reads these. Node, Next.js, CI or the build set them; do not set them by hand.
# ============================================================================================================
#   NODE_ENV: set by Next.js and the Docker image
#   CI: set by CI; makes the Postgres test suites mandatory
#   NEXT_PHASE: set by Next.js
#   NEXT_RUNTIME: set by Next.js
#   NEXT_PUBLIC_CONTACT_EMAIL: derived at build time from CONTACT_EMAIL
#   NEXT_PUBLIC_STAFF_EMAIL_DOMAIN: derived at build time from STAFF_EMAIL_DOMAIN
#   NEXT_PUBLIC_SENTRY_ENVIRONMENT: derived at build time from SENTRY_ENVIRONMENT, NEXT_PUBLIC_ENVIRONMENT or DIDIT_ENV
#   NEXT_PUBLIC_SENTRY_RELEASE: derived at build time from SENTRY_RELEASE or the build id
